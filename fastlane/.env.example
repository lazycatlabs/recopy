# Copy to fastlane/.env (git-ignored). App Store Connect › Users and Access › Integrations › Team Keys,
# role App Manager. Used for signing, uploading and the App Store listing: no Apple ID or 2FA needed.
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
